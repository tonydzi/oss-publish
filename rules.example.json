    "assigned-secret": "(?i)\\b(?:token|secret|passwd|password|api_?key|access_key|session_string)\\b\\s*[:=]\\s*[\"'](?![^\"']*(?:\\{|\\$|%|\\[\\[|REPLACE|YOUR_|<))[^\"'\\s]{10,}[\"']",
    "real-name": "(?i)Olsen|Belova|Pike|Voss|Дроздов|Марин[аыуеой]|Кирилл(?!иц)",
    "real-handle": "(?i)@dave_ops|@m_belova|@sunrisecap|@h_pike",
    "bare-slug": "(?i)daveolsen|mbelova|sunrisecap",
    "real-email": "(?i)sunrise-capital|dave\\.olsen",
    "real-host": "(?i)WKSTN-?4711|KESTREL|RASPI-ATTIC",
    "real-phone": "441632960",
    "live-infra": "(?i)sunrise-internal\\.net|192\\.168\\.7\\.22|Kq7bus2Xmesh91|UQgUYuqClh84yOhV",
    "people-roster": "(?:\\(\\s*[\"'][A-Z][A-Za-z.\\-]+(?:\\s+[A-Za-z(][\\w()/.\\- ]*)?[\"']\\s*,\\s*\\d{6,}[^\\n]*\\n[^\\n]*){3,}",
    "user-path": "C:\\\\{1,2}Users\\\\{1,2}[A-Za-z_][A-Za-z0-9_]*|D:\\\\{1,2}Vault|/Users/[a-z]|/home/[a-z]"
  },

  "_gate_soft_README": [
    "The soft tier may be greedier than the hard tier, because a false positive here costs",
    "a human ten seconds and never fails a build. Note that `assigned-secret` below allows",
    "SPACES inside the quoted value while the hard rule does not: a passphrase written as",
    "password = 'correct horse battery staple' evades every no-whitespace rule, and it is",
    "cheaper to read one extra line than to miss that class entirely."
  ],

  "gate_soft": {
    "session-string": "[\"'][A-Za-z0-9+/=_-]{120,}[\"']",
    "assigned-secret": "(?i)\\b(?:token|secret|passwd|password|api_key|apikey|access_key|session)\\b\\s*[:=]\\s*[\"'][^\"']{12,}[\"']",
    "private-ip": "\\b(?:10|192\\.168|172\\.(?:1[6-9]|2\\d|3[01]))\\.\\d{1,3}\\.\\d{1,3}\\b",
    "tailscale-host": "(?i)\\b[a-z0-9-]+\\.(?:ts\\.net|tailnet\\.\\w+)\\b",
    "env-file-path": "(?i)[\\w%\\\\/.-]*(?:secrets?|credential)[\\w%\\\\/.-]*\\.(?:env|json)",
    "leftover-handle": "@[A-Za-z][A-Za-z0-9_]{4,}",
    "bare-url-creds": "https?://[^\\s\"']*:[^\\s\"'@/]+@"
  },

  "gate_soft_allow": {
    "leftover-handle": "(?i)@(?:acme_lab|owner_acct|teammate_m|corp_acct|advisor_p|example|username|handle|channel|param|return|raise|staticmethod|classmethod|property|dataclass|pytest|patch|wraps|contextmanager|abstractmethod)"
  }
}
